---
import Base from '../layouts/Base.astro';
import Card from '../components/Card.astro';
import { articles } from '../data/articles';
---

<Base
  title="Articles · Dr Joseph Early"
  description="Articles and media coverage featuring Dr Joseph Early."
>
  <div class="page-layout">
  <div class="container">
    <div class="page-header">
      <h1>Articles</h1>
    </div>
    <div class="scroll-area">
      <div class="card-grid">
        {articles.map((a) => (
          <Card
            publisher={a.publisher}
            date={a.date}
            image={a.image}
            title={a.title}
            desc={a.desc}
            url={a.url}
          />
        ))}
      </div>
    </div>
  </div>
  </div>
</Base>
