---
import Base from '../layouts/Base.astro';
import PublicationCard from '../components/PublicationCard.astro';
import { papers } from '../data/papers';
---

<Base
  title="Papers · Dr Joseph Early"
  description="Academic papers by Dr Joseph Early."
>
  <div class="page-layout">
    <div class="scroll-area">
      <div class="container">
        <div class="page-header">
          <h1>Papers</h1>
        </div>
        <div class="pub-list">
          {papers.map((p) => (
            <PublicationCard
              venue={p.venue}
              date={p.date}
              title={p.title}
              url={p.url}
              pdf={p.pdf}
              authors={p.authors}
              abstract={p.abstract}
            />
          ))}
        </div>
      </div>
    </div>
  </div>
</Base>
