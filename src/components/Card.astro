---
interface Props {
  publisher: string;
  date: string;
  image: string;
  title: string;
  desc: string;
  url: string;
  imagePosition?: string;
}

const { publisher, date, image, title, desc, url, imagePosition } = Astro.props;
---

<a class="card" href={url} target="_blank" rel="noopener noreferrer">
  <img
    class="card-image"
    src={image}
    alt={title}
    loading="lazy"
    decoding="async"
    style={imagePosition ? `object-position: ${imagePosition};` : undefined}
  />
  <div class="card-meta">
    <span class="card-publisher">{publisher}</span>
    <span class="card-date">{date}</span>
  </div>
  <div class="card-body">
    <h2 class="card-title">{title}</h2>
    <p class="card-desc">{desc}</p>
  </div>
</a>
