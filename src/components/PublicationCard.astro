---
interface Props {
  venue: string;
  date: string;
  title: string;
  url: string;
  pdf?: string;
  authors: string;
  abstract: string;
}

const { venue, date, title, url, pdf, authors, abstract } = Astro.props;
---

<article class="pub-card">
  <div class="pub-meta">
    <span class="pub-venue">{venue}</span>
    <span class="pub-date">{date}</span>
  </div>
  <h2 class="pub-title">
    {pdf && (
      <a
        href={pdf}
        target="_blank"
        rel="noopener noreferrer"
        class="pdf-link"
        aria-label="Download PDF"
        title="Download PDF"
      >
        <i class="fas fa-file-pdf" aria-hidden="true"></i>
      </a>
    )}
    <a href={url} target="_blank" rel="noopener noreferrer" class="stretched-link">{title}</a>
  </h2>
  <p class="pub-authors">{authors}</p>
  <p class="pub-abstract">{abstract}</p>
</article>
